# HTTP server
PORT=3000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cftchat?schema=public"

# Firestore project id (any string is fine when using the emulator)
FIREBASE_PROJECT_ID=cft-chat-dev

# --- Firestore: pick ONE of the two options below ---

# Option A (default, no GCP account needed): use the local Firestore emulator.
# Start it with `npm run emulator`, then keep this line set.
FIRESTORE_EMULATOR_HOST=localhost:8080

# Option B: use a real Firestore project. Comment out FIRESTORE_EMULATOR_HOST
# above and point this at your service-account key file instead.
# FIREBASE_SERVICE_ACCOUNT=./service-account.json
